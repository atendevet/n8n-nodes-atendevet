{
	"name": "@atendevet/n8n-nodes-atendevet",
	"version": "0.1.3",
	"description": "Official Atendevet nodes for n8n: trigger workflows on veterinary clinic events (appointments, payments, vaccines, leads) and read patients, clients, sales, reports and CRM leads. AI agents through the Atendevet MCP server.",
	"license": "MIT",
	"homepage": "https://github.com/atendevet/n8n-nodes-atendevet#readme",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"n8n-nodes",
		"atendevet",
		"veterinaria",
		"veterinary",
		"clinica-veterinaria",
		"automacao",
		"mcp"
	],
	"author": {
		"name": "Atendevet",
		"email": "contato@atendevet.com.br"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/atendevet/n8n-nodes-atendevet.git"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/AtendevetApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Atendevet/Atendevet.node.js",
			"dist/nodes/AtendevetTrigger/AtendevetTrigger.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "*",
		"eslint": "9.39.4",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
