{
  "name": "Atendevet: new appointment to Google Calendar",
  "nodes": [
    {
      "id": "13f71ef6-9370-5ceb-bda2-6c7cd031d92d",
      "name": "Setup",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [
        -420,
        -180
      ],
      "parameters": {
        "content": "## Appointments in your Google Calendar\nEvery appointment booked in Atendevet is copied to a Google Calendar.\n\n1. Add your Atendevet API credential (key with *Receber avisos de eventos*).\n2. Add your Google Calendar credential and choose the calendar.\n3. Activate the workflow. Times come in the clinic's local time.",
        "width": 360,
        "height": 300
      }
    },
    {
      "id": "516f2319-811c-5b11-8368-51ae641a5fec",
      "name": "Atendevet Trigger",
      "type": "@atendevet/n8n-nodes-atendevet.atendevetTrigger",
      "typeVersion": 1,
      "position": [
        0,
        0
      ],
      "parameters": {
        "events": [
          "agendamento.criado"
        ]
      },
      "webhookId": "a4758bac-f464-513d-8919-451afdf375ac"
    },
    {
      "id": "4ee2f370-f80f-5953-b804-23f77af337c0",
      "name": "Create event",
      "type": "n8n-nodes-base.googleCalendar",
      "typeVersion": 1.3,
      "position": [
        260,
        0
      ],
      "parameters": {
        "calendar": {
          "__rl": true,
          "mode": "list",
          "value": ""
        },
        "start": "={{ $json.dados.inicio }}",
        "end": "={{ $json.dados.fim || DateTime.fromISO($json.dados.inicio).plus({ hours: 1 }).toISO() }}",
        "additionalFields": {
          "summary": "={{ $json.dados.titulo }}",
          "description": "=Booked in Atendevet for {{ $json.dados.tutor }}"
        }
      }
    }
  ],
  "connections": {
    "Atendevet Trigger": {
      "main": [
        [
          {
            "node": "Create event",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  },
  "pinData": {},
  "meta": {
    "templateCredsSetupCompleted": false
  }
}
